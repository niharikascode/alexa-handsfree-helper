#!/bin/bash
# Minimal computer-use toolkit pinned to the task display. Screenshots are
# numbered (never overwritten) so every re-read is a genuinely new observation.
# Set CUA_OUT to the directory that should hold _shots/ and actions.log.
set -u
export DISPLAY="${VNC_DISPLAY:-:37}"
OUT="${CUA_OUT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)/_run/agent}"
SHOTS="$OUT/shots"; mkdir -p "$SHOTS"
log() { echo "$(date +%s.%N) $*" >> "$OUT/actions.log"; }

case "${1:-}" in
  shot)
    n=$(( $(ls "$SHOTS" | grep -c '^s[0-9]*\.png$') + 1 ))
    f="$SHOTS/s$n.png"; scrot -o "$f" 2>/dev/null; log "shot $f"; echo "$f" ;;
  click)       xdotool mousemove "$2" "$3" click 1; log "click $2 $3"; sleep 0.6 ;;
  rightclick)  xdotool mousemove "$2" "$3" click 3; log "rightclick $2 $3"; sleep 0.6 ;;
  doubleclick) xdotool mousemove "$2" "$3" click --repeat 2 1; log "doubleclick $2 $3"; sleep 0.6 ;;
  drag)        xdotool mousemove "$2" "$3" mousedown 1 mousemove "$4" "$5" mouseup 1; log "drag $*"; sleep 0.6 ;;
  type)        shift; xdotool type --delay 25 -- "$*"; log "type $*"; sleep 0.4 ;;
  key)         shift; xdotool key -- "$@"; log "key $*"; sleep 0.5 ;;
  clear)       xdotool key ctrl+a; xdotool key BackSpace; log clear; sleep 0.3 ;;
  scroll)
    btn=5; [ "${2:-down}" = up ] && btn=4
    for _ in $(seq 1 "${3:-5}"); do xdotool click "$btn"; sleep 0.12; done
    log "scroll ${2:-down} ${3:-5}"; sleep 0.4 ;;
  goto)        # kiosk/full-screen Chrome has no address bar: use its local DevTools port when open
               if (exec 3<>/dev/tcp/127.0.0.1/"${CUA_CDP_PORT:-9444}") 2>/dev/null; then
                 node "$(dirname "${BASH_SOURCE[0]}")/nav.mjs" "$2" >/dev/null
               else xdotool key ctrl+l; sleep 0.3; xdotool type --delay 20 -- "$2"; xdotool key Return; fi
               log "goto $2"; sleep 3 ;;
  wait)        sleep "${2:-1}"; log "wait ${2:-1}" ;;
  *) cat <<'USAGE'
cua shot                 screenshot; prints a file path - Read it to look
cua click|rightclick|doubleclick X Y
cua drag X1 Y1 X2 Y2
cua type <text>          type into whatever has focus
cua key <key>...         e.g. Return, Tab, ctrl+a, BackSpace
cua clear                select-all + delete
cua scroll up|down [n]
cua goto <url>           navigate the browser's current tab
cua wait <seconds>
USAGE
  ;;
esac
